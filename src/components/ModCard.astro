---
import type { Mod } from '../data/mods';
import {
  MC_SERIES,
  localModUrl,
  modrinthProjectUrl,
} from '../data/mods';
import type { Stat } from '../lib/modrinth';

interface Props {
  mod: Mod;
  stat: Stat;
  index: number;
}
const { mod, stat, index } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-US');
const detailsHref = localModUrl(mod);
const projectHref = modrinthProjectUrl(mod);
const categories = [...mod.categories, ...mod.additionalCategories];
---

<article
  class="card panel"
  style={`--accent: var(--${mod.accent}); --reveal-delay:${index * 0.06}s`}
  data-modrinth-project={mod.modrinthId}
  data-fallback-downloads={mod.fallback.downloads}
  data-fallback-followers={mod.fallback.followers}
  data-fallback-version={mod.modrinthVersionId}
  data-reveal
>
  <div class="card-head">
    <a class="card-icon-link" href={detailsHref} aria-label={`Explore ${mod.name}`}>
      <img
        class="card-icon"
        src={`/mods/${mod.slug}/icon.png`}
        alt=""
        width="80"
        height="80"
        loading="lazy"
        decoding="async"
        data-modrinth-icon
        data-fallback-src={`/mods/${mod.slug}/icon.png`}
      />
    </a>
    <div class="card-id">
      <p class="card-kicker">Current release</p>
      <p class="card-version" data-modrinth-field="version">{mod.releaseVersion}</p>
      <h3 class="card-name">
        <a href={detailsHref}><span data-modrinth-field="title">{mod.name}</span></a>
      </h3>
    </div>
  </div>

  <p class="card-tag" data-modrinth-field="description">{mod.summary}</p>

  <div
    class="card-cats"
    data-modrinth-categories
    data-category-variant="dot"
    role="group"
    aria-label="Project categories"
  >
    {categories.map((category) => (
      <span class="dot-cat" data-modrinth-category-item>{category}</span>
    ))}
  </div>

  <dl class="card-specs">
    <div>
      <dt>Minecraft</dt>
      <dd data-modrinth-field="game-versions">{MC_SERIES}</dd>
    </div>
    <div>
      <dt>Install</dt>
      <dd data-modrinth-field="environment-short">Server-first</dd>
    </div>
  </dl>

  <dl class="card-metrics">
    <div class="metric">
      <dt class="metric-lbl">Downloads</dt>
      <dd class="metric-num" data-modrinth-field="downloads">{fmt(stat.downloads)}</dd>
    </div>
    <div class="metric">
      <dt class="metric-lbl">Followers</dt>
      <dd class="metric-num" data-modrinth-field="followers">{fmt(stat.followers)}</dd>
    </div>
  </dl>

  <div class="card-actions">
    <a class="card-go card-go--primary" href={detailsHref}>Explore details →</a>
    <a
      class="card-go card-go--external"
      href={projectHref}
      target="_blank"
      rel="noopener noreferrer"
      data-modrinth-href="project"
    >Modrinth <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
    height: 100%;
    padding: clamp(1.2rem, 1rem + 0.8vw, 1.55rem);
    overflow: hidden;
    border-left: 3px solid var(--accent);
    transition: transform 0.18s var(--ease), border-color 0.18s var(--ease),
      background 0.18s var(--ease);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    background: var(--panel-2);
  }
  .card:hover .card-go--primary,
  .card:focus-within .card-go--primary {
    color: var(--accent);
  }

  .card-head {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .card-icon-link {
    border-radius: 7px;
  }
  .card-id {
    min-width: 0;
  }
  .card-icon {
    width: 80px;
    height: 80px;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 6px;
    image-rendering: auto;
    background: var(--void);
    border: 1px solid var(--line);
  }
  .card-kicker {
    color: var(--faint);
    font-family: var(--font-pixel);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card-name {
    margin-top: 0.45rem;
    font-size: var(--step-1);
    overflow-wrap: anywhere;
  }
  .card-version {
    margin-top: 0.2rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .card-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
  }
  .dot-cat {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    color: var(--faint);
    text-transform: lowercase;
  }
  .dot-cat::before {
    content: '#';
    color: var(--accent);
    opacity: 0.7;
  }

  .card-tag {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .card-specs,
  .card-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem 1.2rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
  }
  .card-specs dt,
  .metric-lbl {
    color: var(--faint);
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card-specs dd {
    margin: 0.3rem 0 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    overflow-wrap: anywhere;
  }
  .metric {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 0.2rem;
  }
  .metric-num {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--ink);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .card-go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-pixel);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    transition: color 0.18s var(--ease);
  }
  .card-go:hover {
    color: var(--accent);
  }
  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: auto;
  }
  .card-go--external {
    text-align: right;
  }
  @media (max-width: 380px) {
    .card-head {
      grid-template-columns: 64px minmax(0, 1fr);
    }
    .card-icon {
      width: 64px;
      height: 64px;
    }
  }
</style>
