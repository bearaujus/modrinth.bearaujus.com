---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ModCard from '../components/ModCard.astro';
import ModShowcase from '../components/ModShowcase.astro';
import Principles from '../components/Principles.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';

import {
  CATALOG_REVIEWED_AT,
  MODS,
  SITE_URL,
} from '../data/mods';
import { getStats, totals } from '../lib/modrinth';
import { personSchema, softwareSchema } from '../lib/structured-data';

// Live Modrinth stats, fetched at build time (falls back to static counts).
const stats = await getStats();
const t = totals(stats);
const statFor = (mod: (typeof MODS)[number]) => stats[mod.modrinthId] ?? mod.fallback;

const site = Astro.site?.href.replace(/\/$/, '') ?? SITE_URL;

// Schema.org structured data for rich search results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'bearaujus — Minecraft Fabric Mods',
      description:
        'Server-first Minecraft 26.2.x Fabric mods for dimension changes, death recovery, and multiplayer sleep, published by bearaujus on Modrinth.',
      inLanguage: 'en',
      dateModified: CATALOG_REVIEWED_AT,
      publisher: { '@id': `${site}/#person` },
    },
    personSchema(site),
    {
      '@type': 'ItemList',
      name: 'Minecraft Fabric mods by bearaujus',
      itemListOrder: 'https://schema.org/ItemListUnordered',
      numberOfItems: MODS.length,
      itemListElement: MODS.map((mod, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: softwareSchema(mod, statFor(mod), site),
      })),
    },
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
---

<Base>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={jsonLdText}
  />
  <Nav />
  <main id="main-content">
    <Hero totalDownloads={t.downloads} />

    <section class="section mods" id="mods">
      <div class="wrap">
        <p class="eyebrow" data-reveal>The mods</p>
        <h2 class="mods-title" data-reveal style="--reveal-delay:0.05s">
          Four mods, all live on Modrinth.
        </h2>

        <div class="mods-grid">
          {MODS.map((mod, i) => (
            <ModCard mod={mod} stat={statFor(mod)} index={i} />
          ))}
        </div>

        <div class="mods-detail">
          {MODS.map((mod, i) => (
            <ModShowcase mod={mod} stat={statFor(mod)} index={i} />
          ))}
        </div>
      </div>
    </section>

    <Principles />
    <About stats={stats} />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/reveal.ts';
</script>

<style>
  .mods-title {
    margin-top: 1rem;
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .mods-grid {
    margin-top: clamp(2rem, 1rem + 3vw, 3rem);
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
  }
  .mods-detail {
    margin-top: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
</style>
