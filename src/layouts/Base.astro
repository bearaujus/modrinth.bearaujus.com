---
// Self-hosted fonts (bundled at build, no runtime network call).
// The static display/mono faces only need the Latin subset used by this site.
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import '../styles/tokens.css';
import '../styles/global.css';
import BootScreen from '../components/BootScreen.astro';

export interface Props {
  title?: string;
  description?: string;
  robots?: string;
  imageAlt?: string;
}

const {
  title = 'Server-First Minecraft Fabric Mods | bearaujus',
  description = 'Four server-first Minecraft 26.2.x Fabric mods by bearaujus: dimension change notifications, death coordinates, multiplayer sleep thresholds, and live sleep progress.',
  robots = 'index, follow, max-image-preview:large',
  imageAlt = 'bearaujus — server-first Minecraft Fabric mods, live on Modrinth',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// This root-level color paints before the render-blocking stylesheet arrives.
// Keep it in sync with --void in styles/tokens.css.
---

<!doctype html>
<html lang="en" style="background-color: #0b0d10; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      // Opt into the boot UI only when JavaScript can also dismiss it.
      document.documentElement.dataset.boot = 'pending';
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="bearaujus (Haryo Bagas Assyafah)" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/json"
      href="/catalog.json"
      title="Bearaujus mod catalog"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href={interLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="theme-color" content="#0b0d10" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="modrinth.bearaujus.com" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Per-page structured data and extra head tags -->
    <slot name="head" />

  </head>
  <body>
    <BootScreen />
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
